---
// Resume page, based on the "Resume" frame of the Figma prototype.
// "Download PDF" prints the page; the print stylesheet hides the site chrome.
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Reveal from '../components/Reveal.astro';
import iconLinkedin from '../assets/icons/linkedin.svg';
import iconMail from '../assets/icons/mail.svg';
import iconPortfolio from '../assets/icons/portfolio.svg';
import { resume } from '../data/resume';
import { localePath } from '../lib/i18n';

const { lang } = Astro.props;
const r = resume[lang];
const otherLang = lang === 'fa' ? 'en' : 'fa';

const blocks = [
  { title: r.sections.experience, items: r.experience },
  { title: r.sections.education, items: r.education },
  { title: r.sections.courses, items: r.courses },
];
---
<Base title={`${lang === 'fa' ? 'رزومه' : 'Resume'} — ${r.name}`} description={`${r.name}, ${r.role}`} lang={lang} altHref={localePath(otherLang, '/resume/')}>
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Amiko:wght@400;600;700&display=swap" rel="stylesheet" />
  <Nav lang={lang} current="resume" altHref={localePath(otherLang, '/resume/')} />

  <main class="resume">
    <Reveal as="header" class="resume-head">
      <h1>{r.name}</h1>
      <p class="resume-role">{r.role}</p>
      <ul class="resume-links">
        <li>
          <img src={iconLinkedin.src} width="24" height="24" alt="" />
          <a href="https://www.linkedin.com/in/reyhane-davarpanah/" target="_blank" rel="noopener" dir="ltr">/in/reyhane-davarpanah</a>
        </li>
        <li>
          <img src={iconMail.src} width="24" height="24" alt="" />
          <a href="mailto:re.davarpanah@gmail.com" dir="ltr">re.davarpanah@gmail.com</a>
        </li>
        <li class="no-print">
          <img src={iconPortfolio.src} width="24" height="24" alt="" />
          <button type="button" class="resume-print" onclick="window.print()">{r.print}</button>
        </li>
      </ul>
    </Reveal>

    <hr class="resume-rule" />

    {blocks.map((block) => (
      <Reveal as="section" class="resume-block">
        <h2>{block.title}</h2>
        <div class="resume-items">
          {block.items.map((item) => (
            <article class="resume-item">
              <h3>{item.title}</h3>
              <p class="resume-meta"><span>{item.place}</span><span>{item.date}</span></p>
              {item.points && (
                <ul>
                  {item.points.map((p) => <li>{p}</li>)}
                </ul>
              )}
            </article>
          ))}
        </div>
      </Reveal>
    ))}

    <Reveal as="section" class="resume-block">
      <h2>{r.sections.skills}</h2>
      <div class="resume-items resume-skills">
        {r.skills.map((s) => (
          <div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </Reveal>
  </main>
</Base>
