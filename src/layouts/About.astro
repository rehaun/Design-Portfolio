---
import { getEntry, render } from 'astro:content';
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Reveal from '../components/Reveal.astro';
import Section from '../components/Section.astro';
import Figure from '../components/Figure.astro';
import { ui, url, localePath } from '../lib/i18n';

const { lang } = Astro.props;
const entry = await getEntry('about', lang);
const { Content } = await render(entry);
const otherLang = lang === 'fa' ? 'en' : 'fa';
---
<Base title={`${entry.data.title} — ${ui[lang].brand}`} description={entry.data.intro} lang={lang}>
  <Nav lang={lang} altHref={localePath(otherLang, '/about/')} />
  <div class="container">
    <div class="cs-header">
      <Reveal>
        <h1 class="cs-title">{entry.data.title}</h1>
        <p class="cs-subtitle">{entry.data.intro}</p>
      </Reveal>
    </div>

    <Content components={{ Reveal, Section, Figure }} />

    <hr class="divider" />
    <div class="footer">
      <a href={url('/')}>{ui[lang].backHome}</a>
    </div>
  </div>
</Base>
