---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Reveal from '../components/Reveal.astro';
import { ui, localePath } from '../lib/i18n';

const { lang } = Astro.props;
const otherLang = lang === 'fa' ? 'en' : 'fa';

const copy = {
  en: {
    title: 'Happy to see you’ve found this page!',
    text: 'It’s still a work in progress 😅, but feel free to reach out. I’d love to connect!',
    mail: 'Mail',
    linkedin: 'LinkedIn',
  },
  fa: {
    title: 'خوشحالم که این صفحه را پیدا کردی!',
    text: 'این صفحه هنوز در حال ساخت است 😅، ولی خوشحال می‌شوم پیام بدهی و با هم در ارتباط باشیم!',
    mail: 'ایمیل',
    linkedin: 'لینکدین',
  },
}[lang];

const contacts = [
  { label: copy.mail, href: 'mailto:re.davarpanah@gmail.com', text: 're.davarpanah@gmail.com' },
  { label: copy.linkedin, href: 'https://www.linkedin.com/in/reyhane-davarpanah/', text: '/in/reyhane-davarpanah', external: true },
];
---
<Base title={`${ui[lang].about} — ${ui[lang].name}`} description={copy.text} lang={lang}>
  <Nav lang={lang} current="about" altHref={localePath(otherLang, '/about/')} />
  <main class="about container">
    <Reveal class="about-hero">
      <span class="about-emoji" aria-hidden="true">🌻</span>
      <h1>{copy.title}</h1>
      <p>{copy.text}</p>
    </Reveal>

    <Reveal class="contact-list" delay={0.1}>
      {contacts.map((c) => (
        <div class="contact">
          <p class="contact-label">{c.label}</p>
          <a
            href={c.href}
            class="contact-link"
            dir="ltr"
            target={c.external ? '_blank' : undefined}
            rel={c.external ? 'noopener' : undefined}
          >{c.text}</a>
        </div>
      ))}
    </Reveal>
  </main>
</Base>
