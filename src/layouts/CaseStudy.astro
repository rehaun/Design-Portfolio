---
import { getCollection, render } from 'astro:content';
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Reveal from '../components/Reveal.astro';
import Figure from '../components/Figure.astro';
import Img from '../components/Img.astro';
import Section from '../components/Section.astro';
import PhaseDivider from '../components/PhaseDivider.astro';
import Compare from '../components/Compare.astro';
import Gallery from '../components/Gallery.astro';
import MediaText from '../components/MediaText.astro';
import { images } from '../data/images';
import { ui, localePath, parseId } from '../lib/i18n';

const { entry } = Astro.props;
const { lang, slug } = parseId(entry.id);
const { title, subtitle, eyebrow, hero, meta } = entry.data;
const { Content } = await render(entry);

const otherLang = lang === 'fa' ? 'en' : 'fa';
const hasTranslation = (await getCollection('work')).some((e) => e.id === `${otherLang}/${slug}`);
const altHref = hasTranslation ? localePath(otherLang, `/${slug}/`) : undefined;

const components = { Img, Reveal, Figure, Section, PhaseDivider, Compare, Gallery, MediaText };
---
<Base title={`${title} — ${ui[lang].name}`} description={subtitle} lang={lang} altHref={altHref} image={images[hero]}>
  <Nav lang={lang} current="works" altHref={altHref} progress />
  <div class="container cs">
    <div class="cs-header">
      <Reveal>
        <div class="cs-eyebrow">{eyebrow}</div>
        <h1 class="cs-title">{title}</h1>
        <p class="cs-subtitle">{subtitle}</p>
        <div class="meta-box">
          {meta.map((m, i) => (
            <>
              {i > 0 && <Fragment set:html="&nbsp;·&nbsp; " />}
              <strong>{m.label}:</strong> {m.value}{' '}
            </>
          ))}
        </div>
      </Reveal>
      <Figure src={images[hero]} bare />
    </div>

    <Content components={components} />

    <hr class="divider" />
    <div class="footer">
      <a href={localePath(lang, '/')} class="back-link">{ui[lang].backHome}</a>
    </div>
  </div>

  <dialog class="lightbox" aria-label={title}>
    <button type="button" class="lightbox-close" aria-label={lang === 'fa' ? 'بستن' : 'Close'}>×</button>
    <img class="lightbox-img" alt="" />
  </dialog>

  <script>
    // Click/tap any case-study image to see it large (handy for dense diagrams on phones).
    const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
    const big = dialog?.querySelector<HTMLImageElement>('.lightbox-img');
    if (dialog && big) {
      document
        .querySelectorAll<HTMLImageElement>('.container .media-surface img')
        .forEach((img) => {
          img.classList.add('zoomable');
          img.addEventListener('click', () => {
            big.src = img.currentSrc || img.src;
            big.alt = img.alt;
            dialog.showModal();
          });
        });
      dialog.querySelector('.lightbox-close')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
    }
  </script>
</Base>
