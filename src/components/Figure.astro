---
// A single image on a card. The image is sized to one of a few width tiers
// (360 / 560 / 720 / full column) so the page keeps a steady rhythm.
// wide: a diagram that should keep its size and scroll sideways on phones.
// bare: the image already has its own background, so skip the card padding.
// decor: a loose illustration with no card; small and not zoomable.
// melt: near-white image backdrops take on the card colour (slightly off-white or pure white alike).
// fit: a very wide diagram shown whole (no sideways swipe); tap/click opens it large and scrollable.
// nozoom: keeps its look but is purely decorative, so no zoom cursor and no lightbox.
// end: sit at the end of the line (right in English, left in Persian) instead of the middle.
import { getImage } from 'astro:assets';
import Img from './Img.astro';
import Reveal from './Reveal.astro';
import { swipeHint } from './media.js';

const { src, alt = '', label, caption, width, wide = false, fit = false, bare = false, blend = false, melt = false, decor = false, nozoom = false, end = false, scrollWidth, hint = swipeHint(Astro.currentLocale) } = Astro.props;
// a wide diagram opens in the lightbox from a much larger copy, so it stays readable when scrolled
const zoomSrc = (wide || fit) && src.format !== 'svg' ? (await getImage({ src, width: Math.min(src.width, 6000), format: 'webp' })).src : undefined;
const TIERS = [140, 180, 240, 360, 460, 560, 720];
const tier = width ? (TIERS.find((t) => width <= t) ?? 'full') : 'full';
---
<Reveal as="figure" class:list={['figure', `figure--${tier}`, bare && 'figure--bare', blend && 'figure--blend', melt && 'melt', decor && 'figure--decor', end && 'figure--end']}>
  {label && <span class="figure-label">{label}</span>}
  <div class:list={['figure-surface', !decor && !nozoom && 'media-surface']}>
    {fit ? (
      <Img src={src} alt={alt} data-zoom={zoomSrc} />
    ) : wide ? (
      <div class="media-scroll" data-hint={hint} style={scrollWidth ? `--scroll-w: ${scrollWidth}px` : undefined}><Img class="cmp-diagram" src={src} alt={alt} data-zoom={zoomSrc} /></div>
    ) : (
      <Img src={src} alt={alt} />
    )}
  </div>
  {caption && <figcaption class="figure-caption media-caption" set:html={caption} />}
</Reveal>
