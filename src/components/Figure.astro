---
// A single image on a card. The image is sized to one of a few width tiers
// (360 / 560 / 720 / full column) so the page keeps a steady rhythm.
// wide: a diagram that should keep its size and scroll sideways on phones.
// bare: the image already has its own background, so skip the card padding.
// decor: a loose illustration with no card; small and not zoomable.
import Img from './Img.astro';
import Reveal from './Reveal.astro';
import { swipeHint } from './media.js';

const { src, alt = '', label, caption, width, wide = false, bare = false, blend = false, decor = false, scrollWidth, hint = swipeHint(Astro.currentLocale) } = Astro.props;
const TIERS = [180, 240, 360, 560, 720];
const tier = width ? (TIERS.find((t) => width <= t) ?? 'full') : 'full';
---
<Reveal as="figure" class:list={['figure', `figure--${tier}`, bare && 'figure--bare', blend && 'figure--blend', decor && 'figure--decor']}>
  {label && <span class="figure-label">{label}</span>}
  <div class:list={['figure-surface', !decor && 'media-surface']}>
    {wide ? (
      <div class="media-scroll" data-hint={hint} style={scrollWidth ? `--scroll-w: ${scrollWidth}px` : undefined}><Img class="cmp-diagram" src={src} alt={alt} /></div>
    ) : (
      <Img src={src} alt={alt} />
    )}
  </div>
  {caption && <figcaption class="figure-caption media-caption" set:html={caption} />}
</Reveal>
