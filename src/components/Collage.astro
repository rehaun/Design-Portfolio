---
import Img from './Img.astro';
// A freeform collage of overlapping/adjacent images, positioned by exact
// percentages measured from the original Framer site.
// `aspect` = container width/height ratio (e.g. 941/297).
// `items` = [{ src, alt, left, top, width, height }] all in % of the container.
import Reveal from './Reveal.astro';
const { aspect, items } = Astro.props;
---
<Reveal class="figure">
  <div class="collage" style={`aspect-ratio: ${aspect}`}>
    {items.map((it) => (
      <Img
        src={it.src}
        alt={it.alt || ''}
        loading="lazy"
        style={`position: absolute; left: ${it.left}%; top: ${it.top}%; width: ${it.width}%; height: ${it.height}%`}
      />
    ))}
  </div>
</Reveal>
