---
import avatar from '../assets/brand/avatar.svg';
import avatarHover from '../assets/brand/avatar-hover.svg';
import { ui, url, localePath } from '../lib/i18n';

// `altHref`: the same page in the other language, if it exists.
// `current`: which nav item to mark as the current page.
// `progress`: show a reading-progress line along the bottom edge (case studies).
const { lang = 'en', altHref, current, progress = false } = Astro.props;
// There is no Persian home page yet, so "Works" always points at the English one.
const links = [
  { key: 'works', href: url('/') },
  { key: 'about', href: localePath(lang, '/about/') },
  { key: 'play', href: localePath(lang, '/play/') },
  { key: 'resume', href: localePath(lang, '/resume/') },
];
---
<header class="nav">
  <div class="nav-inner">
    <a href={url('/')} class="nav-brand" aria-label={ui[lang].name} data-avatar>
      <span class="nav-avatar">
        <img src={avatar.src} width={avatar.width} height={avatar.height} alt="" class="avatar-face" />
        <img src={avatarHover.src} width={avatarHover.width} height={avatarHover.height} alt="" class="avatar-face avatar-happy" />
      </span>
    </a>
    <nav class="nav-links">
      {links.map((l) => (
        <a href={l.href} class="nav-link" aria-current={current === l.key ? 'page' : undefined}>{ui[lang][l.key]}</a>
      ))}
      {altHref && <a href={altHref} class="nav-lang" lang={lang === 'fa' ? 'en' : 'fa'}>{lang === 'fa' ? 'EN' : 'فا'}</a>}
    </nav>
  </div>
  {progress && <span class="nav-progress" data-progress aria-hidden="true"></span>}
</header>

<script>
  // Avatar "happy" face (the Hover=On variant from Figma).
  // Mouse: shown on hover via CSS. Touch: a tap shows it for a beat before
  // navigating, and the avatar says hello once per visit when the page opens.
  const brand = document.querySelector<HTMLAnchorElement>('[data-avatar]');
  const touch = matchMedia('(hover: none)').matches;
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (brand && touch && !calm) {
    const smile = (ms: number) => {
      brand.classList.add('is-happy');
      setTimeout(() => brand.classList.remove('is-happy'), ms);
    };
    brand.addEventListener('click', (e) => {
      e.preventDefault();
      smile(600);
      setTimeout(() => (location.href = brand.href), 380);
    });
    let greeted = false;
    try {
      greeted = sessionStorage.getItem('avatar-hello') === '1';
      sessionStorage.setItem('avatar-hello', '1');
    } catch {}
    if (!greeted) setTimeout(() => smile(1100), 700);
  }
</script>
