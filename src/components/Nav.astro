---
import { ui, localePath } from '../lib/i18n';
// `altHref`: the same page in the other language, if it exists.
const { lang = 'en', altHref } = Astro.props;
---
<div class="nav">
  <div class="nav-inner">
    <a href={localePath(lang, '/')} class="nav-brand">{ui[lang].brand}</a>
    <div class="nav-links">
      <a href={localePath(lang, '/play/')} class="nav-link">{ui[lang].play}</a>
      <a href={localePath(lang, '/about/')} class="nav-link">{ui[lang].about}</a>
      {altHref && (
        <a href={altHref} class="nav-lang" aria-label={ui[lang].switchLang}>
          <span class="nav-lang-long">{ui[lang].switchLang}</span>
          <span class="nav-lang-short" aria-hidden="true">{ui[lang].switchLangShort}</span>
        </a>
      )}
    </div>
  </div>
</div>
