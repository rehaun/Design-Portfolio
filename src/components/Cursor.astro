---
// A custom cursor for mouse users: a small dot that follows the pointer exactly
// and a thin ring that trails it. It changes with what is underneath:
//   text   -> the dot becomes a thin bar the height of the text
//   links  -> the ring grows (and leans toward nav items)
//   images -> a yellow disc with a magnifier; next-case card -> an arrow
//   press  -> everything shrinks a little
// Over the avatar the dot becomes a small sunflower. Colour: --cursor,
// a warm orange, with a thin cream edge so it also reads on orange-ish art.
// On touch screens there is no cursor; a small ripple shows where you tapped.
---
<div class="cursor" data-cursor-root data-state="default" aria-hidden="true">
  <div class="cursor-pos" data-cursor-dot><span class="cursor-dot"><svg class="cursor-flower" viewBox="0 0 40 40" aria-hidden="true"><path d="M20 6.5 Q23.2 12.575 20 18 Q16.8 12.575 20 6.5Z" fill="#eaa93b" transform="rotate(0 20 20)"/><path d="M20 6.5 Q23.2 12.575 20 18 Q16.8 12.575 20 6.5Z" fill="#eaa93b" transform="rotate(22.5 20 20)"/><path d="M20 6.5 Q23.2 12.575 20 18 Q16.8 12.575 20 6.5Z" fill="#eaa93b" transform="rotate(45 20 20)"/><path d="M20 6.5 Q23.2 12.575 20 18 Q16.8 12.575 20 6.5Z" fill="#eaa93b" transform="rotate(67.5 20 20)"/><path d="M20 6.5 Q23.2 12.575 20 18 Q16.8 12.575 20 6.5Z" fill="#eaa93b" transform="rotate(90 20 20)"/><path d="M20 6.5 Q23.2 12.575 20 18 Q16.8 12.575 20 6.5Z" fill="#eaa93b" transform="rotate(112.5 20 20)"/><path d="M20 6.5 Q23.2 12.575 20 18 Q16.8 12.575 20 6.5Z" fill="#eaa93b" transform="rotate(135 20 20)"/><path d="M20 6.5 Q23.2 12.575 20 18 Q16.8 12.575 20 6.5Z" fill="#eaa93b" transform="rotate(157.5 20 20)"/><path d="M20 6.5 Q23.2 12.575 20 18 Q16.8 12.575 20 6.5Z" fill="#eaa93b" transform="rotate(180 20 20)"/><path d="M20 6.5 Q23.2 12.575 20 18 Q16.8 12.575 20 6.5Z" fill="#eaa93b" transform="rotate(202.5 20 20)"/><path d="M20 6.5 Q23.2 12.575 20 18 Q16.8 12.575 20 6.5Z" fill="#eaa93b" transform="rotate(225 20 20)"/><path d="M20 6.5 Q23.2 12.575 20 18 Q16.8 12.575 20 6.5Z" fill="#eaa93b" transform="rotate(247.5 20 20)"/><path d="M20 6.5 Q23.2 12.575 20 18 Q16.8 12.575 20 6.5Z" fill="#eaa93b" transform="rotate(270 20 20)"/><path d="M20 6.5 Q23.2 12.575 20 18 Q16.8 12.575 20 6.5Z" fill="#eaa93b" transform="rotate(292.5 20 20)"/><path d="M20 6.5 Q23.2 12.575 20 18 Q16.8 12.575 20 6.5Z" fill="#eaa93b" transform="rotate(315 20 20)"/><path d="M20 6.5 Q23.2 12.575 20 18 Q16.8 12.575 20 6.5Z" fill="#eaa93b" transform="rotate(337.5 20 20)"/><path d="M20 8 Q23.2 13.399999999999999 20 18 Q16.8 13.399999999999999 20 8Z" fill="#f6c445" transform="rotate(11.25 20 20)"/><path d="M20 8 Q23.2 13.399999999999999 20 18 Q16.8 13.399999999999999 20 8Z" fill="#f6c445" transform="rotate(33.75 20 20)"/><path d="M20 8 Q23.2 13.399999999999999 20 18 Q16.8 13.399999999999999 20 8Z" fill="#f6c445" transform="rotate(56.25 20 20)"/><path d="M20 8 Q23.2 13.399999999999999 20 18 Q16.8 13.399999999999999 20 8Z" fill="#f6c445" transform="rotate(78.75 20 20)"/><path d="M20 8 Q23.2 13.399999999999999 20 18 Q16.8 13.399999999999999 20 8Z" fill="#f6c445" transform="rotate(101.25 20 20)"/><path d="M20 8 Q23.2 13.399999999999999 20 18 Q16.8 13.399999999999999 20 8Z" fill="#f6c445" transform="rotate(123.75 20 20)"/><path d="M20 8 Q23.2 13.399999999999999 20 18 Q16.8 13.399999999999999 20 8Z" fill="#f6c445" transform="rotate(146.25 20 20)"/><path d="M20 8 Q23.2 13.399999999999999 20 18 Q16.8 13.399999999999999 20 8Z" fill="#f6c445" transform="rotate(168.75 20 20)"/><path d="M20 8 Q23.2 13.399999999999999 20 18 Q16.8 13.399999999999999 20 8Z" fill="#f6c445" transform="rotate(191.25 20 20)"/><path d="M20 8 Q23.2 13.399999999999999 20 18 Q16.8 13.399999999999999 20 8Z" fill="#f6c445" transform="rotate(213.75 20 20)"/><path d="M20 8 Q23.2 13.399999999999999 20 18 Q16.8 13.399999999999999 20 8Z" fill="#f6c445" transform="rotate(236.25 20 20)"/><path d="M20 8 Q23.2 13.399999999999999 20 18 Q16.8 13.399999999999999 20 8Z" fill="#f6c445" transform="rotate(258.75 20 20)"/><path d="M20 8 Q23.2 13.399999999999999 20 18 Q16.8 13.399999999999999 20 8Z" fill="#f6c445" transform="rotate(281.25 20 20)"/><path d="M20 8 Q23.2 13.399999999999999 20 18 Q16.8 13.399999999999999 20 8Z" fill="#f6c445" transform="rotate(303.75 20 20)"/><path d="M20 8 Q23.2 13.399999999999999 20 18 Q16.8 13.399999999999999 20 8Z" fill="#f6c445" transform="rotate(326.25 20 20)"/><path d="M20 8 Q23.2 13.399999999999999 20 18 Q16.8 13.399999999999999 20 8Z" fill="#f6c445" transform="rotate(348.75 20 20)"/><circle cx="20" cy="20" r="6.8" fill="#8a5a2b"/><circle cx="18" cy="18" r="1.6" fill="#b5834a"/></svg></span></div>
  <div class="cursor-pos" data-cursor-ring>
    <span class="cursor-ring">
      <svg class="cursor-icon cursor-icon--zoom" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6" /><path d="M15 15l5 5M10.5 8v5M8 10.5h5" /></svg>
      <svg class="cursor-icon cursor-icon--next" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </span>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-cursor-root]');
  const dotPos = root?.querySelector<HTMLElement>('[data-cursor-dot]');
  const ringPos = root?.querySelector<HTMLElement>('[data-cursor-ring]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && dotPos && ringPos && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let x = 0, y = 0, tx = 0, ty = 0, rx = 0, ry = 0; // dot, ring target, ring
    let active = false;
    let raf = 0;
    let lastTarget: Element | null = null;
    let state = 'default';

    const draw = () => {
      raf = 0;
      // the trailing ring eases softly toward the pointer; the image/next discs are only a touch closer
      const k = reduce ? 1 : state === 'media' || state === 'next' ? 0.2 : 0.16;
      rx += (tx - rx) * k;
      ry += (ty - ry) * k;
      ringPos.style.transform = `translate3d(${rx}px, ${ry}px, 0)`;
      if (Math.abs(tx - rx) > 0.1 || Math.abs(ty - ry) > 0.1) raf = requestAnimationFrame(draw);
    };
    const schedule = () => { if (!raf) raf = requestAnimationFrame(draw); };

    const setState = (next: string) => {
      if (next !== state) { state = next; root.dataset.state = next; }
    };

    // what is under the pointer decides the shape
    let magnet: Element | null = null;
    const pick = (t: Element | null) => {
      magnet = null;
      if (!t || t.closest('[data-cursor="off"]')) return setState('default');
      if (t.closest('.nav-brand')) return setState('flower');
      if (t.closest('.zoomable, .portrait')) return setState('media');
      if (t.closest('.next-card')) return setState('next');
      const link = t.closest('a, button, summary, [role="button"], .card');
      if (link) {
        if (link.matches('.nav-link, .nav-lang')) magnet = link;
        return setState('link');
      }
      const text = t.closest('p, li, h1, h2, h3, h4, h5, h6, blockquote, figcaption, dt, dd');
      if (text) {
        const fs = parseFloat(getComputedStyle(text).fontSize) || 16;
        root.style.setProperty('--bar-h', `${Math.round(fs * 1.8)}px`);
        return setState('text');
      }
      setState('default');
    };

    const aim = () => {
      tx = x; ty = y;
      if (magnet) { // nav items pull the ring toward their centre
        const r = magnet.getBoundingClientRect();
        tx = x + (r.left + r.width / 2 - x) * 0.3;
        ty = y + (r.top + r.height / 2 - y) * 0.3;
      }
    };

    const activate = (px: number, py: number) => {
      active = true;
      x = tx = rx = px; y = ty = ry = py;
      document.documentElement.classList.add('has-cursor');
      root.classList.remove('is-away');
      root.classList.add('is-ready');
      dotPos.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      draw();
    };

    addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch') return;
      if (!active) activate(e.clientX, e.clientY);
      x = e.clientX; y = e.clientY;
      // the dot moves right now, in the same frame as the pointer; only the ring waits for the animation loop
      dotPos.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      if (e.target !== lastTarget) { lastTarget = e.target as Element; pick(lastTarget); }
      aim();
      root.classList.remove('is-away');
      schedule();
    }, { passive: true });
    addEventListener('pointerdown', (e) => { if (e.pointerType !== 'touch') root.classList.add('is-down'); }, { passive: true });
    addEventListener('pointerup', () => root.classList.remove('is-down'), { passive: true });
    addEventListener('dragend', () => root.classList.remove('is-down'));
    document.documentElement.addEventListener('mouseleave', () => root.classList.add('is-away'));
    document.documentElement.addEventListener('mouseenter', () => root.classList.remove('is-away'));
    // the element under a still pointer changes while the page scrolls: look again (once per frame)
    let scrollRaf = 0;
    addEventListener('scroll', () => {
      if (!active || scrollRaf) return;
      scrollRaf = requestAnimationFrame(() => {
        scrollRaf = 0;
        lastTarget = document.elementFromPoint(x, y);
        pick(lastTarget);
        aim();
        schedule();
      });
    }, { passive: true, capture: true });

    // carry the position across page changes so the cursor doesn't blink out
    addEventListener('pagehide', () => { if (active) sessionStorage.setItem('cursor-pos', `${x},${y}`); });
    try {
      const saved = sessionStorage.getItem('cursor-pos')?.split(',').map(Number);
      if (saved && saved.length === 2 && saved.every(Number.isFinite)) activate(saved[0], saved[1]);
    } catch {}
  }

  // touch screens: a soft ripple where the finger lands
  if (matchMedia('(hover: none)').matches && !reduce) {
    addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'touch') return;
      const r = document.createElement('span');
      r.className = 'tap-ripple';
      r.style.left = `${e.clientX}px`;
      r.style.top = `${e.clientY}px`;
      r.addEventListener('animationend', () => r.remove());
      document.body.append(r);
    }, { passive: true });
  }
</script>
