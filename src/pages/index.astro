---
import Img from '../components/Img.astro';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import UnderConstruction from '../components/UnderConstruction.astro';
import Reveal from '../components/Reveal.astro';
import { images } from '../data/images';
import { localePath, parseId } from '../lib/i18n';

const work = (await getCollection('work', (e) => parseId(e.id).lang === 'en')).sort(
  (a, b) => a.data.order - b.data.order,
);
---
<Base>
  <script is:inline>
    // Old links used hash routes (#/classeh-games, #/classeh-games/fa).
    // Send them to the new real URLs.
    (function () {
      var m = location.hash.match(/^#\/([\w-]+)(\/fa)?\/?$/);
      if (!m) return;
      var base = location.pathname.replace(/\/?$/, '/');
      location.replace(base + (m[2] ? 'fa/' : '') + m[1] + '/');
    })();
  </script>

  <Nav lang="en" />

  <UnderConstruction title="Under construction, for now!" text="Explore what's already up:" />

  <div class="container cards">
    {work.map((entry, i) => (
      <Reveal delay={0.05 * (i + 1)}>
        <a href={localePath('en', `/${parseId(entry.id).slug}/`)} class="card">
          <div class="card-image">
            <Img src={images[entry.data.hero]} alt={entry.data.title} loading="lazy" />
          </div>
          <p class="card-title">{entry.data.cardTitle ?? entry.data.title}</p>
          <div class="card-spacer"></div>
          <div class="card-footer">
            <p class="card-eyebrow">{entry.data.eyebrow.toUpperCase()}</p>
            <span class="card-view">VIEW</span>
          </div>
        </a>
      </Reveal>
    ))}
  </div>

  <div class="footer">Made by Davarpanah</div>
</Base>
